# Local development only. Do not copy secrets into this template.
# Generate ignored credentials and a local Keycloak realm with:
#   uv run --locked --group dev python scripts/local_stack.py prepare
# This development identity provider uses HTTP and is bound to loopback by Compose.
PCB_ENVIRONMENT=dev
PCB_ROLE=api
PCB_SERVICE_IDENTITY=local-api
PCB_OIDC_ISSUER=http://127.0.0.1:8080/realms/polycodebench-local
PCB_OIDC_CLIENT_ID=polycodebench-web
PCB_OIDC_REDIRECT_URI=http://127.0.0.1:3001/auth/callback
PCB_WEB_ORIGIN=http://127.0.0.1:3001
PCB_PUBLIC_API_URL=http://127.0.0.1:8010/v1
PCB_OBJECT_STORE_ENDPOINT=http://127.0.0.1:8333
PCB_BUCKET_HIDDEN=pcb-hidden-local
PCB_BUCKET_INTERNAL=pcb-internal-local
PCB_BUCKET_PUBLIC=pcb-public-local

# PCB_DATABASE_URL, PCB_WEB_AUTH_SIGNING_KEY, and PCB_CURSOR_SIGNING_KEY are
# generated into the ignored .env file by scripts/local_stack.py. Never use
# these local credentials in a staging or production environment.
