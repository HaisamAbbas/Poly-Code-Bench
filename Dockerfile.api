# syntax=docker/dockerfile:1.7

# The API image also carries pcb-ops because ECS starts Python services through its
# fail-closed identity guard. Keep both build and runtime Python on the same pinned base.
ARG PYTHON_IMAGE=python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY plugins/ ./plugins/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable \
      --package polycodebench-api \
      --package polycodebench-operations

FROM ${PYTHON_IMAGE} AS runtime
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PCB_ENV_MANIFEST=/etc/pcb/environment.yaml \
    PCB_RELEASE_STORE_PATH=/tmp/public-releases.sqlite3 \
    PCB_ENVIRONMENT=dev
WORKDIR /usr/local
COPY --from=build /opt/venv /opt/venv
# The default image is safe for local development. Production builds must pass their
# reviewed, deployed manifest as PCB_ENV_MANIFEST_SOURCE; a template fails closed.
ARG PCB_ENV_MANIFEST_SOURCE=config/environments/dev.yaml
COPY ${PCB_ENV_MANIFEST_SOURCE} /etc/pcb/environment.yaml
COPY config/operations/migration-policy.yaml /usr/local/config/operations/migration-policy.yaml
COPY infra/observability/ /usr/local/infra/observability/
COPY docs/operations/runbooks/ /usr/local/docs/operations/runbooks/
COPY packages/persistence/alembic.ini /usr/local/packages/persistence/alembic.ini
COPY packages/persistence/src/polycodebench_persistence/migrations/ /usr/local/packages/persistence/src/polycodebench_persistence/migrations/
RUN mkdir -p /tmp /usr/local/.cache && chown 10001:10001 /tmp /usr/local/.cache
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/readyz', timeout=2)" || exit 1
CMD ["uvicorn", "polycodebench_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
