# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY plugins/ ./plugins/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable \
      --package polycodebench-orchestration \
      --package polycodebench-operations \
      --package polycodebench-lang-c \
      --package polycodebench-lang-cpp \
      --package polycodebench-lang-go \
      --package polycodebench-lang-java \
      --package polycodebench-lang-javascript \
      --package polycodebench-lang-python \
      --package polycodebench-lang-rust

FROM ${PYTHON_IMAGE} AS runtime
ARG PCB_ENV_MANIFEST_SOURCE=config/environments/dev.yaml
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PCB_ENV_MANIFEST=/etc/pcb/environment.yaml \
    PCB_ENVIRONMENT=dev \
    PCB_SCORING_DISPATCH_ENABLED=false
WORKDIR /usr/local
COPY --from=build /opt/venv /opt/venv
COPY ${PCB_ENV_MANIFEST_SOURCE} /etc/pcb/environment.yaml
COPY config/plugins/ /usr/local/config/plugins/
COPY config/scoring/ /usr/local/config/scoring/
COPY config/languages/ /usr/local/config/languages/
RUN useradd --system --uid 10001 --user-group --home-dir /home/pcb --create-home \
      --shell /usr/sbin/nologin pcb \
    && mkdir -p /tmp /usr/local/.cache \
    && chown 10001:10001 /tmp /usr/local/.cache /home/pcb
USER 10001:10001
# Terraform supplies the explicit identity-gated scorer command. The default remains inert.
CMD ["pcb-worker", "--help"]
