# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66

FROM ${NODE_IMAGE} AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@12.5.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @polycodebench/web...
COPY apps/web/ ./apps/web/
ARG PCB_PUBLIC_API_URL=http://api:8000/v1
ENV PCB_PUBLIC_API_URL=${PCB_PUBLIC_API_URL}
WORKDIR /workspace/apps/web
RUN pnpm build

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    PCB_PUBLIC_API_URL=http://api:8000/v1
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/apps/web/.next/standalone/ ./
COPY --from=build --chown=10001:10001 /workspace/apps/web/.next/static/ ./apps/web/.next/static/
RUN rm -rf /app/apps/web/.next/cache \
    && mkdir -p /tmp/next-cache \
    && ln -s /tmp/next-cache /app/apps/web/.next/cache \
    && chown -R 10001:10001 /app/apps/web/.next /tmp/next-cache
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then((r) => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"
CMD ["node", "apps/web/server.js"]
