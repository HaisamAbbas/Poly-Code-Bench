{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/frontend-preview-green/types/**/*.ts",
    ".next/frontend-preview-green/dev/types/**/*.ts",
    ".next/prompt30-e2e/types/**/*.ts",
    ".next/prompt30-e2e/dev/types/**/*.ts",
    ".next/prompt31-e2e/types/**/*.ts",
    ".next/prompt31-e2e/dev/types/**/*.ts",
    ".next/prompt32-e2e/types/**/*.ts",
    ".next/prompt32-e2e/dev/types/**/*.ts",
    ".next/prompt99-e2e/types/**/*.ts",
    ".next/prompt99-e2e/dev/types/**/*.ts",
    ".next/prompt100-e2e/types/**/*.ts",
    ".next/prompt100-e2e/dev/types/**/*.ts",
    ".next/design-review-31488/types/**/*.ts",
    ".next/design-review-31488/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev"
  ]
}
