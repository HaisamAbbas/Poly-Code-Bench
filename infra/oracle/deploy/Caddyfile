# Public entry point for the Oracle POC. Everything behind it listens on 127.0.0.1.
{$PCB_PUBLIC_DOMAIN} {
	encode zstd gzip

	# Keycloak (realm discovery, login pages). Its admin console stays private.
	# `handle` blocks are mutually exclusive and tried in order; a bare `respond` would lose to
	# the later `handle /kc/*` because respond sorts after handle in Caddy's directive order.
	@kcadmin path /kc/admin* /kc/realms/master /kc/realms/master/*
	handle @kcadmin {
		respond 404
	}
	handle /kc/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Public read API. Administrative and reviewer routes are not exposed publicly;
	# operators reach them over the SSH tunnel at 127.0.0.1:8010.
	@admin path /v1/admin*
	handle @admin {
		respond 404
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8010
	}

	handle {
		reverse_proxy 127.0.0.1:3001
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
