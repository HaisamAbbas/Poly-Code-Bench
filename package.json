{
  "name": "polycodebench-workspace",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm --filter @polycodebench/web build",
    "test:web:e2e": "pnpm --filter @polycodebench/web test:e2e",
    "contracts:build": "pnpm --filter @polycodebench/contracts build",
    "contracts:test": "pnpm --filter @polycodebench/contracts test:contracts",
    "contracts:typecheck": "pnpm --filter @polycodebench/contracts typecheck",
    "lint": "pnpm --filter @polycodebench/web lint",
    "typecheck": "pnpm --filter @polycodebench/web typecheck"
  }
}
