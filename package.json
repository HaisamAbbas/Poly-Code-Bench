{
  "name": "polycodebench-workspace",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "pnpm --filter @polycodebench/web build",
    "test:web:e2e": "pnpm --filter @polycodebench/web test:e2e",
    "contracts:build": "pnpm --filter @polycodebench/contracts build",
    "contracts:test": "pnpm --filter @polycodebench/contracts test:contracts",
    "contracts:typecheck": "pnpm --filter @polycodebench/contracts typecheck",
    "api:types": "pnpm api:openapi:generate && pnpm --filter @polycodebench/web api:types",
    "api:types:check": "pnpm api:openapi:check && pnpm --filter @polycodebench/web api:types:check",
    "api:openapi:generate": "uv run --locked --all-packages python scripts/export_public_api_openapi.py",
    "api:openapi:check": "uv run --offline --locked --all-packages python scripts/export_public_api_openapi.py --check",
    "lint": "pnpm --filter @polycodebench/web lint",
    "typecheck": "pnpm --filter @polycodebench/web typecheck"
  }
}
