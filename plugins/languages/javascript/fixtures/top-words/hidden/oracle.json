        {"case_id": "top-words countWords folds case", "required": true, "case_kind": "example"},
        {"case_id": "top-words countWords ranks by descending frequency", "required": true, "case_kind": "example"},
        {"case_id": "top-words countWords breaks ties alphabetically", "required": true, "case_kind": "example"},
        {"case_id": "top-words countWords treats digits and punctuation as separators", "required": true, "case_kind": "property"},
        {"case_id": "top-words countWords returns only the ranked prefix", "required": true, "case_kind": "property"},
