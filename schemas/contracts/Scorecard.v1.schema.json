{
  "$defs": {
    "EvaluationState": {
      "enum": [
        "pending",
        "evaluating",
        "needs_review",
        "ready",
        "infra_blocked",
        "quarantined",
        "cancelled"
      ],
      "title": "EvaluationState",
      "type": "string"
    },
    "Gate": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not_applicable"
      ],
      "title": "Gate",
      "type": "string"
    },
    "ScoreDimension": {
      "enum": [
        "correctness",
        "security",
        "efficiency",
        "code_quality",
        "idiomatic",
        "robustness"
      ],
      "title": "ScoreDimension",
      "type": "string"
    },
    "ScoreItem": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "contribution": {
          "maxLength": 10,
          "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$",
          "title": "Contribution",
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/ScoreDimension"
        },
        "effective_weight_bps": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Effective Weight Bps",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "gating_reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gating Reason"
        },
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "const": "score_item",
          "title": "Kind",
          "type": "string"
        },
        "primary_owner": {
          "$ref": "#/$defs/ScoreDimension"
        },
        "raw_value": {
          "anyOf": [
            {
              "maxLength": 10,
              "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Value"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "dimension",
        "item_id",
        "applicable",
        "primary_owner",
        "raw_value",
        "effective_weight_bps",
        "gating_reason",
        "contribution",
        "evidence_ids"
      ],
      "title": "ScoreItem",
      "type": "object"
    }
  },
  "$id": "https://polycodebench.invalid/schemas/contracts/Scorecard.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "created_at": {
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Created At",
      "type": "string"
    },
    "evidence_manifest_digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Manifest Digest",
      "type": "string"
    },
    "gate": {
      "$ref": "#/$defs/Gate"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ScoreItem"
      },
      "title": "Items",
      "type": "array"
    },
    "kind": {
      "const": "scorecard",
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scorecard_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Scorecard Id",
      "type": "string"
    },
    "scorer_digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scorer Digest",
      "type": "string"
    },
    "scoring_policy_digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scoring Policy Digest",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EvaluationState"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Task Version",
      "type": "integer"
    },
    "total_score": {
      "anyOf": [
        {
          "maxLength": 10,
          "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Total Score"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "scorecard_id",
    "task_id",
    "task_version",
    "run_id",
    "candidate_id",
    "evidence_manifest_digest",
    "scoring_policy_digest",
    "scorer_digest",
    "gate",
    "status",
    "total_score",
    "items",
    "created_at"
  ],
  "title": "Scorecard",
  "type": "object"
}
