{
  "$defs": {
    "AdmissionReport": {
      "additionalProperties": false,
      "properties": {
        "alternative_check": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Alternative Check",
          "type": "string"
        },
        "disclosure_check": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Disclosure Check",
          "type": "string"
        },
        "execution_tier": {
          "enum": [
            "local_fixture",
            "development_sandbox",
            "production_worker"
          ],
          "title": "Execution Tier",
          "type": "string"
        },
        "faulty_check": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Faulty Check",
          "type": "string"
        },
        "flakiness_check": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Flakiness Check",
          "type": "string"
        },
        "kind": {
          "const": "admission_report",
          "title": "Kind",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "reference_check": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Reference Check",
          "type": "string"
        },
        "report_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Report Digest",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "maxLength": 35,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed At"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewer Id"
        },
        "rights_check": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Rights Check",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "profile_id",
        "report_digest",
        "execution_tier",
        "reference_check",
        "faulty_check",
        "alternative_check",
        "flakiness_check",
        "rights_check",
        "disclosure_check",
        "reviewer_id",
        "reviewed_at"
      ],
      "title": "AdmissionReport",
      "type": "object"
    },
    "ProtocolConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "dependency_inventory_digest": {
          "anyOf": [
            {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dependency Inventory Digest"
        },
        "hidden_feedback": {
          "title": "Hidden Feedback",
          "type": "boolean"
        },
        "kind": {
          "const": "protocol_constraints",
          "title": "Kind",
          "type": "string"
        },
        "maximum_model_turns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Maximum Model Turns",
          "type": "integer"
        },
        "maximum_tool_calls": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Maximum Tool Calls",
          "type": "integer"
        },
        "maximum_wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Maximum Wall Seconds",
          "type": "integer"
        },
        "network_policy": {
          "enum": [
            "disabled",
            "allowlisted"
          ],
          "title": "Network Policy",
          "type": "string"
        },
        "protocol_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Protocol Id",
          "type": "string"
        },
        "public_test_feedback": {
          "title": "Public Test Feedback",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "protocol_id",
        "allowed_tools",
        "public_test_feedback",
        "hidden_feedback",
        "network_policy",
        "dependency_inventory_digest",
        "maximum_model_turns",
        "maximum_tool_calls",
        "maximum_wall_seconds"
      ],
      "title": "ProtocolConstraints",
      "type": "object"
    },
    "ScoreDimension": {
      "enum": [
        "correctness",
        "security",
        "efficiency",
        "code_quality",
        "idiomatic",
        "robustness"
      ],
      "title": "ScoreDimension",
      "type": "string"
    },
    "TaskAcceptance": {
      "additionalProperties": false,
      "properties": {
        "hard_condition_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Hard Condition Ids",
          "type": "array"
        },
        "kind": {
          "const": "task_acceptance",
          "title": "Kind",
          "type": "string"
        },
        "protected_paths": {
          "items": {
            "description": "UTF-8 relative POSIX path; rejects absolute, NUL, dot and parent components.",
            "format": "pcb-relative-posix-path",
            "minLength": 1,
            "type": "string"
          },
          "title": "Protected Paths",
          "type": "array"
        },
        "required_outputs": {
          "items": {
            "description": "UTF-8 relative POSIX path; rejects absolute, NUL, dot and parent components.",
            "format": "pcb-relative-posix-path",
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Outputs",
          "type": "array"
        },
        "required_test_group_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Required Test Group Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "required_test_group_ids",
        "hard_condition_ids",
        "required_outputs",
        "protected_paths"
      ],
      "title": "TaskAcceptance",
      "type": "object"
    },
    "TaskBundleRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "const": "task_bundle_ref",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "artifact_id",
        "digest",
        "visibility"
      ],
      "title": "TaskBundleRef",
      "type": "object"
    },
    "TaskOracle": {
      "additionalProperties": false,
      "properties": {
        "ground_truth_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ground Truth Version"
        },
        "kind": {
          "const": "task_oracle",
          "title": "Kind",
          "type": "string"
        },
        "reference_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Version"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "test_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Test Version"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "test_version",
        "ground_truth_version",
        "reference_version"
      ],
      "title": "TaskOracle",
      "type": "object"
    },
    "TaskOutputContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "items": {
            "description": "UTF-8 relative POSIX path; rejects absolute, NUL, dot and parent components.",
            "format": "pcb-relative-posix-path",
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Paths",
          "type": "array"
        },
        "findings_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Findings Limit"
        },
        "kind": {
          "const": "task_output_contract",
          "title": "Kind",
          "type": "string"
        },
        "maximum_artifact_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Maximum Artifact Bytes",
          "type": "integer"
        },
        "maximum_file_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Maximum File Bytes",
          "type": "integer"
        },
        "maximum_files": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Maximum Files",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "submission_kind": {
          "enum": [
            "files",
            "patch",
            "structured_findings",
            "text",
            "typed_json"
          ],
          "title": "Submission Kind",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "submission_kind",
        "allowed_paths",
        "maximum_artifact_bytes",
        "maximum_file_bytes",
        "maximum_files",
        "findings_limit"
      ],
      "title": "TaskOutputContract",
      "type": "object"
    },
    "TaskQualityPlan": {
      "additionalProperties": false,
      "properties": {
        "applicable_dimensions": {
          "items": {
            "$ref": "#/$defs/ScoreDimension"
          },
          "title": "Applicable Dimensions",
          "type": "array"
        },
        "evidence_owners": {
          "patternProperties": {
            "^[a-z0-9][a-z0-9._-]{0,127}$": {
              "$ref": "#/$defs/ScoreDimension"
            }
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Evidence Owners",
          "type": "object"
        },
        "judge_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Judge Policy Id"
        },
        "kind": {
          "const": "task_quality_plan",
          "title": "Kind",
          "type": "string"
        },
        "performance_policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Performance Policy Id"
        },
        "required_analyzers": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Required Analyzers",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "applicable_dimensions",
        "evidence_owners",
        "required_analyzers",
        "performance_policy_id",
        "judge_policy_id"
      ],
      "title": "TaskQualityPlan",
      "type": "object"
    },
    "TaskRuntime": {
      "additionalProperties": false,
      "properties": {
        "build_recipe_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Recipe Digest",
          "type": "string"
        },
        "image_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "kind": {
          "const": "task_runtime",
          "title": "Kind",
          "type": "string"
        },
        "language_plugin_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Language Plugin Id",
          "type": "string"
        },
        "language_plugin_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Language Plugin Version",
          "type": "string"
        },
        "resource_class": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Resource Class",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "test_recipe_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Test Recipe Digest",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "image_digest",
        "language_plugin_id",
        "language_plugin_version",
        "build_recipe_digest",
        "test_recipe_digest",
        "resource_class"
      ],
      "title": "TaskRuntime",
      "type": "object"
    },
    "TaskSource": {
      "additionalProperties": false,
      "properties": {
        "curated_at": {
          "maxLength": 35,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Curated At",
          "type": "string"
        },
        "date_confidence": {
          "enum": [
            "verified",
            "estimated",
            "unknown"
          ],
          "title": "Date Confidence",
          "type": "string"
        },
        "first_public_at": {
          "anyOf": [
            {
              "maxLength": 35,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Public At"
        },
        "immutable_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Immutable Revision",
          "type": "string"
        },
        "issue_or_cve": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Or Cve"
        },
        "kind": {
          "const": "task_source",
          "title": "Kind",
          "type": "string"
        },
        "rights_record_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Rights Record Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source_kind",
        "immutable_revision",
        "rights_record_id",
        "first_public_at",
        "curated_at",
        "date_confidence"
      ],
      "title": "TaskSource",
      "type": "object"
    },
    "Visibility": {
      "enum": [
        "hidden",
        "internal",
        "public"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "$id": "https://polycodebench.invalid/schemas/contracts/TaskVersion.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "$ref": "#/$defs/TaskAcceptance"
    },
    "admission_report": {
      "$ref": "#/$defs/AdmissionReport"
    },
    "cluster_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Cluster Id",
      "type": "string"
    },
    "difficulty": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Difficulty",
      "type": "string"
    },
    "family": {
      "enum": [
        "bug_hunt",
        "codegen",
        "repo_repair",
        "repo_task",
        "self_repair",
        "repo_qa",
        "output_prediction",
        "test_prediction"
      ],
      "title": "Family",
      "type": "string"
    },
    "hidden_bundle": {
      "$ref": "#/$defs/TaskBundleRef"
    },
    "kind": {
      "const": "task_version",
      "title": "Kind",
      "type": "string"
    },
    "oracle": {
      "$ref": "#/$defs/TaskOracle"
    },
    "output_contract": {
      "$ref": "#/$defs/TaskOutputContract"
    },
    "output_contract_digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Contract Digest",
      "type": "string"
    },
    "primary_language": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Primary Language",
      "type": "string"
    },
    "protocol_constraints": {
      "$ref": "#/$defs/ProtocolConstraints"
    },
    "quality_plan": {
      "$ref": "#/$defs/TaskQualityPlan"
    },
    "runtime": {
      "$ref": "#/$defs/TaskRuntime"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secondary_languages": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Secondary Languages",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/TaskSource"
    },
    "stratum_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Stratum Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "track": {
      "enum": [
        "A",
        "B"
      ],
      "title": "Track",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Version",
      "type": "integer"
    },
    "visible_bundle": {
      "$ref": "#/$defs/TaskBundleRef"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "task_id",
    "version",
    "track",
    "family",
    "primary_language",
    "secondary_languages",
    "source",
    "cluster_id",
    "difficulty",
    "stratum_id",
    "visible_bundle",
    "hidden_bundle",
    "output_contract_digest",
    "output_contract",
    "runtime",
    "acceptance",
    "quality_plan",
    "oracle",
    "protocol_constraints",
    "admission_report"
  ],
  "title": "TaskVersion",
  "type": "object"
}
