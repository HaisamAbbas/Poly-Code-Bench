{
  "$defs": {
    "CohortTask": {
      "additionalProperties": false,
      "properties": {
        "applicable_metrics": {
          "default": [
            "total_score",
            "pass_rate"
          ],
          "items": {
            "type": "string"
          },
          "title": "Applicable Metrics",
          "type": "array"
        },
        "cluster_id": {
          "title": "Cluster Id",
          "type": "string"
        },
        "earliest_public_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliest Public At"
        },
        "kind": {
          "const": "cohort_task",
          "default": "cohort_task",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stratum": {
          "title": "Stratum",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Task Version",
          "type": "integer"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "language",
        "stratum",
        "cluster_id"
      ],
      "title": "CohortTask",
      "type": "object"
    },
    "StratumWeight": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stratum_weight",
          "default": "stratum_weight",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "stratum": {
          "title": "Stratum",
          "type": "string"
        },
        "weight_bps": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Weight Bps",
          "type": "integer"
        }
      },
      "required": [
        "language",
        "stratum",
        "weight_bps"
      ],
      "title": "StratumWeight",
      "type": "object"
    }
  },
  "$id": "https://polycodebench.invalid/schemas/publication/CohortPolicy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability_policy_digest": {
      "title": "Applicability Policy Digest",
      "type": "string"
    },
    "budget_tier": {
      "title": "Budget Tier",
      "type": "string"
    },
    "comparison_filter": {
      "default": "all",
      "title": "Comparison Filter",
      "type": "string"
    },
    "compatibility_policy_digest": {
      "title": "Compatibility Policy Digest",
      "type": "string"
    },
    "editorial_index_enabled": {
      "const": false,
      "default": false,
      "title": "Editorial Index Enabled",
      "type": "boolean"
    },
    "evaluator_digest": {
      "title": "Evaluator Digest",
      "type": "string"
    },
    "hardware_class": {
      "title": "Hardware Class",
      "type": "string"
    },
    "judge_panel_digest": {
      "title": "Judge Panel Digest",
      "type": "string"
    },
    "kind": {
      "const": "cohort_policy",
      "default": "cohort_policy",
      "title": "Kind",
      "type": "string"
    },
    "planned_samples": {
      "default": 3,
      "exclusiveMinimum": 0,
      "title": "Planned Samples",
      "type": "integer"
    },
    "protocol_digest": {
      "title": "Protocol Digest",
      "type": "string"
    },
    "required_languages": {
      "items": {
        "type": "string"
      },
      "title": "Required Languages",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scorer_digest": {
      "title": "Scorer Digest",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    },
    "stratum_weights": {
      "items": {
        "$ref": "#/$defs/StratumWeight"
      },
      "title": "Stratum Weights",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/CohortTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "tool_context_policy_digest": {
      "title": "Tool Context Policy Digest",
      "type": "string"
    }
  },
  "required": [
    "tasks",
    "required_languages",
    "stratum_weights",
    "protocol_digest",
    "tool_context_policy_digest",
    "budget_tier",
    "scorer_digest",
    "evaluator_digest",
    "judge_panel_digest",
    "hardware_class",
    "seeds",
    "applicability_policy_digest",
    "compatibility_policy_digest"
  ],
  "title": "CohortPolicy",
  "type": "object"
}
